public class Reservation implements Comparable<Reservation> {

    Scanner input = new Scanner(System.in);// halah add 
    private String reservationID;
    private String associatedGuestID;
    private String checkInDate;
    private String checkOutDate;
    private int numberOfGuests;
    private String reservationStatus;
    private String specialRequests;
    private String bookingDate;
    private User user;
    private Room room;
    private Invoice invoice;//invoice for current reservation
    private ArrayList<Service> services = new ArrayList<>();//saves all services for all reservations 
    private Service service;
    private static ArrayList<Invoice> allInvoices = new ArrayList<>();//saves all invoices for all reservations 
    private static int reservationCounter;// counts total reservations made and helps with ID generation
    private FeedBack guestFeedBack; // i add set and get and add this one 
