        System.out.println(" --- Managing System Users and Roles --- ");
        System.out.print("What would you to do? (Enter a number)"
                + "\n1. Add a user"
                + "\n2. Edit a user"
                + "\n3. Remove a user"
                + "\n4. Assign a role"
                + "\nEnter here: ");
        int choice = in.nextInt();
        in.nextLine();
        
        switch (choice) {
            case 1://Add a user
                LocalDate date = LocalDate.now();// to get current date
                String dateString = date.toString();
                System.out.print("Enter the following details: \nID: ");
                String ID = in.nextLine();
                System.out.print("\nRole (Enter a number): \n1.Guest \n2.Receptionist \n3.Manager\nEnter here: ");
