        }
        System.out.println(" We are happy to serve you. Have a nice day! ");
        System.out.println("--------------------------------------------------------------");

    }

    public void SearchAvailableRooms(String CheckInDate, String CheckOutDate, int guests, String roomType, ArrayList<Room> rooms, ArrayList<Reservation> reservations) {

        Collections.sort(rooms);
        int count = 0;
        for (Room room1 : rooms) {
            if (room1.getRoomStatus() == "Available") {
                System.out.println(room1 + "\n");
                count++;
            }

        }

        Collections.sort(reservations);
        for (Reservation reservation1 : reservations) {
            if (CheckInDate == reservation1.getCheckInDate() & CheckOutDate == reservation1.getCheckOutDate() & guests == reservation1.getNumberOfGuests()) {
                continue;
            } else {
                System.out.println(reservation1 + "\n");
                count++;
            }

        }

        if (count == 0) {
            System.out.println("There are no rooms available");
        }
    }

    @Override
    public String toString() {
        return super.toString() + "\nReservation: " + guestReservation + "\nService Request: " + guestService;
    }

    public void ViewInvoice() {
        System.out.println(guestReservation.getInvoice());
    }

    public void MakeAPayment() {
        if (guestReservation.getInvoice().getPaymentStatus() == "Unpaid") {
            System.out.print("Choose a payment method: \n1.Cash \n2.Card \n3.Online Transfer");
            int paymentChoice = input.nextInt();

            switch (paymentChoice) {
                case 1:
                    guestReservation.getInvoice().setPaymentMethod("Cash");
                    break;
                case 2:
                    guestReservation.getInvoice().setPaymentMethod("Card");
                    break;
                case 3:
                    guestReservation.getInvoice().setPaymentMethod("Online Transfer");
                    break;
                default:
                    System.out.println("Invalid payment method!");
            }

            System.out.print("How much would you like to pay?");
            double payment = input.nextDouble();

            while (payment < 0 | payment > guestReservation.getInvoice().getTotalAmount()) {
                if (payment > guestReservation.getInvoice().getTotalAmount()) {
                    System.out.println("That exceeds your bills!");
                } else {
                    System.out.println("That is an invalid amount!");
                }

                System.out.println("Try again!");
                payment = input.nextDouble();
            }

            if (payment == guestReservation.getInvoice().getTotalAmount()) {
                guestReservation.getInvoice().setPaymentStatus("Paid");
            } else if (payment < guestReservation.getInvoice().getTotalAmount() & payment > 0) {
                guestReservation.getInvoice().setPaymentStatus("Partially Paid");
            }

            System.out.println("Payment succefull!");
            ViewInvoice();
        }
    }
}
