    // lamia's methods 
    
    // This method is used by the guest when looking for rooms and making reservations 
    public void SearchAvailableRooms(String CheckInDate, String CheckOutDate, int guests, ArrayList<Room> rooms, ArrayList<Reservation> reservations) {

        Collections.sort(rooms); // to display from highest price to lowest price
        int count = 0; //to check how many rooms available
        for (Room room1 : rooms) {//checks the rooms that have an available status
            if (room1.getRoomStatus() == "Available") {
                System.out.println((count+1) + ". " + room1 + "\n");
                count++;
            }

        }

        Collections.sort(reservations);// to display from highest price to lowest price
        for (Reservation reservation1 : reservations) { // checks the reservations that have different check in/out dates than what the guest requested
            if (CheckInDate == reservation1.getCheckInDate() & CheckOutDate == reservation1.getCheckOutDate() & guests == reservation1.getNumberOfGuests()) {
                continue;
            } else {
                System.out.println((count+1) + ". " + reservation1 + "\n");
                count++;
            }

        }

        if (count == 0) {
            System.out.println("There are no rooms available");
        }
    }

