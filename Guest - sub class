public class Guest extends User {

    Scanner input = new Scanner(System.in);

    private ArrayList<Service> guestService;
    private Reservation guestReservation;
    
    public Guest(ArrayList<Service> guestService, Reservation guestReservation, String userId, String userJoiningDate, String userName, String userEmail, String userPhone, String userAddress, String role) {
        super(userId, userJoiningDate, userName, userEmail, userPhone, userAddress, role);
        this.guestService = guestService;
        this.guestReservation = guestReservation;
    }

    public ArrayList<Service> getGuestService() {
        return guestService;

    }

    public void setGuestService(ArrayList<Service> guestService) {
        this.guestService = guestService;
    }

    public Reservation getGuestReservation() {
        return guestReservation;
    }

    public void setGuestReservation(Reservation guestReservation) {
        this.guestReservation = guestReservation;
    }

    public void updateupdateContactInfo() {
        System.out.println("--------------------------------------------------------------");
        System.out.println("--- Welcome to the Guest Information Update Center --- ");

        System.out.println(" Please select the specific infomation you would like to upadte.  ");
        System.out.println(" 1- Email ");
        System.out.println(" 2- Phone Number ");
        System.out.println(" 3- Address ");
        System.out.println(" 4- Updare All Information ");

        String selection = input.nextLine();

        switch (selection) {

            case "Email":
                System.out.println(" Kindly enter the email you wish to update. ");
                String updatedEmail = input.nextLine();

                super.setUserEmail(updatedEmail);
                System.out.println(" *** email has been successfully updated ***");
                break;
            case "Phone Number":
                System.out.println(" Kindly enter the phone number you wish to update. ");
                String updatedPhoneNumber = input.nextLine();
                super.setUserPhone(updatedPhoneNumber);
                System.out.println(" *** phone number has been successfully updated *** ");
                break;
            case "Address":
                System.out.println(" Kindly enter the address you wish to update. ");
                String updatedAddress = input.nextLine();
                super.setUserAddress(updatedAddress);
                System.out.println(" *** address has been successfully updated *** ");
                break;
            case "Update All Information":
                String[] updateAll = new String[3];
                System.out.println(" Kindly enter the email you wish to update. ");
                updateAll[0] = input.nextLine();
                super.setUserEmail(updateAll[0]);
                System.out.println(" Kindly enter the phone number you wish to update. ");
                updateAll[1] = input.nextLine();
                super.setUserPhone(updateAll[1]);
                System.out.println(" Kindly enter the address you wish to update. ");
                updateAll[2] = input.nextLine();
                super.setUserAddress(updateAll[2]);
