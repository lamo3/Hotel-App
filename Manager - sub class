    public void ManageRoomInventory(LinkedList<Room> rooms) {
        Scanner in = new Scanner(System.in);

        System.out.println("Would you like to (Enter a number): "
                + "\n1.Add a new room? "
                + "\n2.Update room details? "
                + "\n3.Remove a room?");
        int choice = in.nextInt();

        switch (choice) {
            case 1:// add new room
                System.out.print("Enter the following: \nRoom Type: ");
                String roomType = in.nextLine();
                System.out.print("\nFloor Number: ");
                int floorNumber = in.nextInt();
                System.out.println("\nBed Type: ");
                String bedType = in.nextLine();
                rooms.add(new Room(roomType, floorNumber, bedType));
                break;
            case 2:// update room details
                System.out.println("Which room would you like to update? (Enter the room number)");
                for (Room room1 : rooms) {
                    System.out.println(room1);
                }
                String roomNumber = in.nextLine();

                for (Room room1 : rooms) {
                    if (roomNumber == room1.getRoomNumber()) {
                        System.out.println("What would you like to update? (Enter a number)\n1.Price \n2.Amenities \n3.Bed Type");
                        int choice1 = in.nextInt();
                        switch (choice1) {
                            case 1://update price
                                System.out.print("Enter the price: ");
                                double price = in.nextDouble();
                                room1.setPricePerNight(price);
                                break;
                            case 2://update amenities
                                String[] amenities = new String[4];
                                System.out.print("Enter the Amenities: \n1. ");
                                String amenities1 = in.nextLine();
                                int i = 0;
                                while (amenities1 == null | amenities1 == "") {
                                    amenities[i] = amenities1;
                                    i++;
                                    System.out.print((i + 1) + ". ");
                                    amenities1 = in.nextLine();
                                }
                                room1.setAmenities(amenities);
                                break;
                            case 3://update bed type
                                System.out.print("Enter the bed type: ");
                                String bedType1 = in.nextLine();
                                room1.setBedType(bedType1);
                            default:
                                System.out.println("Invalid choice!");
                        }
                    }
                }
                break;
            case 3://remove a room
                System.out.println("Which room would you like to remove? (Enter the room number)");
                for (Room room1 : rooms) {
                    System.out.println(room1);
                }
                String roomNumber1 = in.nextLine();

                for (Room room1 : rooms) {
                    if (roomNumber1 == room1.getRoomNumber()) {
                        rooms.remove(room1);
                    }
                }

                break;
            default:
                System.out.println("Invalid choice!");
        }
    }

    public void UpdateRoomPricing(LinkedList<Room> rooms) {
        Scanner in = new Scanner(System.in);
        System.out.println("Which room type? (enter a number) \n1. Single \n2. Double \n3. Suite \n4. Deluxe");
        int choice = in.nextInt();
        System.out.print("Enter the price change for this room type: ");
        double price = in.nextDouble();

        switch (choice) {
            case 1:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Single") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            case 2:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Double") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            case 3:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Suite") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            case 4:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Deluxe") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            default:
                System.out.println("Invalid choice!");
        }
    }

    //helps manager edit roles
    public void ManageSystemUsersAndRoles(ArrayList<User> users) {
        Scanner in = new Scanner(System.in);
        System.out.println("--------------------------------------------------------------\n");

        System.out.println(" --- Managing System Users and Roles --- ");
        System.out.println("What would you to do? (Enter a number)"
                + "\n1. Add a user"
                + "\n2. Edit a user"
                + "\n3. Remove a user"
                + "\n4. Assign a role");
        int choice = in.nextInt();
        
        switch (choice) {
            case 1://Add a user
                LocalDate date = LocalDate.now();// to get current date
                String dateString = date.toString();
                System.out.println("Enter the following details: \nID:");
                String ID = in.nextLine();
                System.out.println("\nRole (Enter a number): \n1.Guest \n2.Receptionist \n3.Manager");
                int role = in.nextInt();
                System.out.println("\nName:");
                String name = in.nextLine();
                System.out.println("\nEmail:");
                String email = in.nextLine();
                System.out.println("\nPhone number:");
                String phone = in.nextLine();
                System.out.println("\nAddress:");
                String address = in.nextLine();

                switch (role) {
                    case 1://guest
                        users.add(new Guest(ID, dateString, name, email, phone, address, "Guest"));
                        System.out.println("User added!");
                        break;
                    case 2://receptionist
                        users.add(new Receptionist(ID, dateString, name, email, phone, address, "Receptionist"));
                        System.out.println("User added!");
                        break;
                    case 3://manager
                        users.add(new Manager(ID, dateString, name, email, phone, address, "Manager"));
                        System.out.println("User added!");
                        break;
                    default:
                        System.out.println("Invalid role!");
                }
                break;
            case 2://edit a user
                System.out.print("Enter the ID for the user you want to edit: ");
                ID = in.nextLine();
                for(User user: users){
                    if(user.getUserId() == ID){
                        System.out.println("What would you like to edit? (Enter a number)"
                                + "\n1. Name"
                                + "\n2. Email"
                                + "\n3. Phone number"
                                + "\n4. Address");
                        choice = in.nextInt();
                        
                        switch (choice) {
                            case 1:// edit name
                                System.out.print("Enter a new name: ");
                                name = in.nextLine();
                                user.setUserName(name);
                                break;
                            case 2:// edit email
                                System.out.print("Enter a new email: ");
                                email = in.nextLine();
                                user.setUserEmail(email);
                                break;
                            case 3://edit phone number 
                                System.out.print("Enter a new phone number: ");
                                phone = in.nextLine();
                                user.setUserPhone(phone);
                                break;
                            case 4:// edit address
                                System.out.print("Enter a new Address: ");
                                address = in.nextLine();
                                user.setUserAddress(address);
                                break;
                        }
                    }
                    
                    else
                        System.out.println("there is no user under this ID");
                }
                break;
            case 3://remove a user
                int counter = 0;
                for(User user: users){// makes sure that if there is only one manager then they can't be deleted
                    if(user instanceof Manager)
                        counter++;
                }
                
                System.out.print("Enter the ID of the user you want to remove: ");
                ID = in.nextLine();
                for(User user: users){
                    if(user.getUserId() == ID){
                        if(user.getRole() == "Manager" & counter == 1)
                            System.out.println("You cannot remove this user because they are the only manager!");
                        else{
                            users.add(user);
                            System.out.println("The user was removed!");
                        }
                    }
                    
                    else
                        System.out.println("There is no user under this ID.");
                }
                
                break;
            case 4:// assign a role
                System.out.print("Enter the ID of the user you want to edit the role for: ");
                ID = in.nextLine();
                for(User user: users){
                    if(user.getUserId() == ID){
                        System.out.println("Select a role: (Enter a number)"
                                + "\n1. Guest"
                                + "\n2. Receptionist"
                                + "\n3. Manager");
                        role = in.nextInt();
                        
                        switch(role){
                            case 1://assign guest role
                                user.setRole("Guest");
                                break;
                            case 2://assign receptionist role
                                user.setRole("Receptionist");
                                break;
                            case 3://assign manager role
                                user.setRole("Manager");
                                break;
                            default :
                                System.out.println("Invalid role!");
                        }
                    }
                }
                
                break;
            default :
                System.out.println("Invalid option!");
        }
    }

}
