    public static void Guest(ArrayList<User> users, Guest guest) {

        System.out.println("\n----- Welcome " + guest.getUserName() + "! -----");
        System.out.print("What would you like to do? (Enter a number; 0 to exit)"
                + "\n1. Search for available rooms "
                + "\n2. Make a reservation"
