    public void processServiceRequests(ArrayList<Service> service) {

        System.out.println("Here are the services requests : ");
        for (Service s : service) {// To go through all services.
            if (s.getServiceStatus().equals("Requested")) {// To ensure we only get the orders with status "Requested".
                System.out.println("Service Id : " + s.getServiceId());
                System.out.println("Service Name : " + s.getServiceName());
                System.out.println("Service description : " + s.getDescription());
                System.out.println("Please choose the updated status : ");// To update the status.
                System.out.println("1- In Progress. ");
                System.out.println("2- Completed. ");
                System.out.println("3- Cancelled. ");
                int updatedStatus = input.nextInt();

                switch (updatedStatus) {// using a switch for fatser and more accurate access for guest choice.
                    case 1:
                        s.setServiceStatus("In Progress");
                        break;
                    case 2:
                        s.setServiceStatus("Completed");
                        break;
                    case 3:
                        s.setServiceStatus("Cancelled");
                        break;

                }
                System.out.println("Service status has been updated successfully.");
            }
        }

    }

    // lamia methods
    // used by the receptionist to create a last minute reservation for a guest
    public void CreateAWalkInReservation(ArrayList<Room> rooms, ArrayList<Reservation> reservations, ArrayList<User> users) {

        System.out.println("Enter the following:");

        boolean correct;
        String checkInDate;
        String checkOutDate;
        do {//checks validity of dates
            System.out.print("Enter a check in date(DD/MM/YYYY): ");
            checkInDate = input.nextLine();
            System.out.print("Enter a check out date(DD/MM/YYYY): ");
            checkOutDate = input.nextLine();

            if (Reservation.checkDates(checkInDate, checkOutDate)) {
                correct = false;
            } else {
                System.out.println("Invalid dates! try again.");
                correct = true;
            }

        } while (correct);

        System.out.print("\nNumber of guests (1-4): ");
        int numberOfguests = input.nextInt();
        while (numberOfguests < 1 | numberOfguests > 4) {//checks validity of number of guests
            System.out.println("Invalid number of guests!");
            numberOfguests = input.nextInt();
        }

        Collections.sort(rooms); // to display from highest price to lowest price
        int count = 0;
        for (Room room1 : rooms) {
            if ("Available".equals(room1.getRoomStatus()) & numberOfguests <= room1.getMaxOccupancy()) {
                System.out.println((count + 1) + ". " + room1 + "\n");
                count++;
            }

        }

        Collections.sort(reservations);// to display from highest price to lowest price
        for (Reservation reservation1 : reservations) {
            if (checkInDate.equals(reservation1.getCheckInDate()) & checkOutDate.equals(reservation1.getCheckOutDate()) & !(reservation1.getReservationStatus().equals("Cancelled")) | !(numberOfguests <= reservation1.getRoom().getMaxOccupancy())) {
                continue;
            } else {
                System.out.println((count + 1) + ". " + reservation1.getRoom().toString() + "\n");
                count++;
            }
        }

        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy", Locale.ENGLISH);//to ensure the date is in a specific format
        LocalDate date = LocalDate.now(); // to give an accurate booking date
        String dateNow = date.format(formatter);//localdate to string
        if (count != 0) {// if there are rooms available enter the if statement
            System.out.print("Enter the room number for the room you would like to reserve: ");
            String roomNumber = input.next();

            input.nextLine();

            System.out.print("Enter the guest ID: ");
            String guestID = input.nextLine();
            Guest g = null;
            boolean found = false;

            while (!found) {
                for (User user : users) {//finds user and casts it
                    if (user instanceof Guest && user.getUserId().equals(guestID)) {
                        g = (Guest) user;
                        found = true;
                        break;
                    }
                }

                if (!found) {
                    System.out.println("There are no guests under this ID. Try again.");
                    System.out.print("Enter the guest ID: ");
                    guestID = input.nextLine();
                }
            }
            System.out.print("Any special requests? ");
            String specialRequest = input.nextLine();

            for (Room room1 : rooms) {
                if (roomNumber.equals(room1.getRoomNumber())) {// checks to see if there is a room available
                    reservations.add(new Reservation(g, checkInDate, checkOutDate, numberOfguests, specialRequest, dateNow, room1));
                    g.getGuestReservation().add(reservations.getLast());
                    break;
                }

            }

            String ID = reservations.getLast().getReservationID();
            System.out.println("\nReservation Successfull! \nReservation ID: " + ID);
        } else {
            System.out.println("There are no rooms available.");
        }
    }

    // lets receptionist change the rooms status based on different situations
    public void ChangeRoomStatus(String roomStatus, String roomNumber, ArrayList<Room> rooms) {
        for (Room room : rooms) {
            if (room.getRoomNumber() == roomNumber) {
                room.setRoomStatus(roomStatus);
            }
        }
    }
