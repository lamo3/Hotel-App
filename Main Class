    public static void viewHotalStatistics() {
        for(User user: users){
            if(user instanceof Guest)
                guest.add((Guest)user);
        }
        System.out.println("Total number of rooms : " + room.size());// using .size() to get the total number of rooms
        System.out.println("Total number of Reservation : " + reservation.size());// using .size() to get the total number of reservation
        System.out.println(" Total number of guests : " + guest.size());// using .size() to get the total number of guest
        System.out.println("--------------------------------------------------------------");
        System.out.println("Rooms by status : ");
        int statuAvailableCount = 0;// to count available rooms.
        int statuOccupiedCount = 0;// to count occuiped rooms.
        int statuUnderMaintenanceCount = 0;// to count UnderMaintenance rooms.
        int statuReservedCount = 0;// to count Reserved rooms.
        for (Room r : room) {// to loop through all rooms
            switch (r.getRoomStatus()) {
                case "Available":
                    statuAvailableCount++;// incerement one.
                    break;
                case "Occupied":
                    statuOccupiedCount++;// incerement one.
                    break;
                case "Under Maintenance":
                    statuUnderMaintenanceCount++;// incerement one.
                    break;
                case "Reserved":
                    statuReservedCount++;// incerement one.
                    break;
            }

        }
        System.out.println("Available : " + statuAvailableCount);
        System.out.println("Occupied : " + statuOccupiedCount);
        System.out.println("Under Maintenance : " + statuUnderMaintenanceCount);
        System.out.println("Reserved : " + statuReservedCount);

        System.out.println("Room by type : ");
        int typeSingle = 0;// to count single rooms.
        int typeDouble = 0;// to count double rooms.
        int typeSuite = 0;// to count suite
        int typeDeluxe = 0; //to count deluxe rooms

