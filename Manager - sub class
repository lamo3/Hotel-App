                        }
                        
                        notFound = false;
                        break;
                    }
                    
                }
                
                if(notFound)
                    System.out.println("there is no user under this ID");
                
                break;
            case 3://remove a user
                int counter = 0;
                for(User user: users){// makes sure that if there is only one manager then they can't be deleted
                    if(user instanceof Manager)
                        counter++;
                }
                
                int counter2 = 0;
                for(User user: users){// makes sure that if there is only one manager then they can't be deleted
                    if(user instanceof Receptionist)
                        counter2++;
                }
                
                System.out.print("Enter the ID of the user you want to remove: ");
                ID = in.nextLine();
                notFound = true;
                for(User user: users){
                    if(user.getUserId().equals(ID)){
                        if(("Manager".equals(user.getRole()) & counter == 1) | ("Receptionist".equals(user.getRole()) & counter2 == 1)){//makes sure that if theres only one manager/receptionist isnt deleted
                            System.out.println("You cannot remove this user because they are the only " + user.getClass().getSimpleName() + "!");
                            notFound = false;
                            break;
                        }
                        else {//removes user
                            users.add(user);
