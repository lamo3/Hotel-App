    public FeedBack submitGuestFeedback() {
        if (this.reservationStatus.equals("Checked-Out")) {// To ensure that the reservation status is "Cheacked-Out".
            String feedbackId = "FI" + countF;// To ensure the each feedback ID has a unique ID.
            countF++;// Increment by one everytime.
            System.out.println("--------------------------------------------------------------");
            System.out.println("Please enter your rating number : ");
            int rating = input.nextInt();
            System.out.println("Please enter your comments : --optional--");
            String comment = input.nextLine();
            System.out.println("Thank you for your valuable feedback. We look forward to serving you again!");
            if (comment != null && !comment.equals("")) {// if the user has submmited a comment. We will use the cons that accepts a comment.
                setGuestFeedBack(new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, comment, LocalDate.now().toString()));
                return new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, comment, LocalDate.now().toString());
            } else {//// else if the user hasn't submmited a comment. We will use the cons that doesn't accepts a comment.
                setGuestFeedBack(new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, LocalDate.now().toString()));
                return new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, LocalDate.now().toString());

            }

        }
        return null;

    }
    
    
    //verifies dates
    public static boolean checkDates(String checkIn, String checkOut){//makes sure that dates entered by the user arent before the current date and are in the right order
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy", Locale.ENGLISH);
        LocalDate in = LocalDate.parse(checkIn, formatter);
        LocalDate out = LocalDate.parse(checkOut, formatter);
        
        return (in.isAfter(LocalDate.now()) | in.equals(LocalDate.now())) & out.isAfter(LocalDate.now()) & out.isAfter(in);
    }
}
