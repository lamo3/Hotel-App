    public void ManageRoomInventory(ArrayList<Room> rooms) {
        Scanner in = new Scanner(System.in);
        boolean notFound = true;// to check that the room specified is exists
        
        System.out.println("Would you like to (Enter a number): "
                + "\n1.Add a new room? "
                + "\n2.Update room details? "
                + "\n3.Remove a room?");
        int choice = in.nextInt();
        in.nextLine();
        
        switch (choice) {
            case 1:// add new room
                System.out.print("Enter the following: \nRoom Type: ");
                String roomType = in.nextLine();
                System.out.print("\nFloor Number: ");
                int floorNumber = in.nextInt();
                in.nextLine();
                System.out.print("\nBed Type: ");
                String bedType = in.nextLine();
                rooms.add(new Room(roomType, floorNumber, bedType));
                System.out.println("Room was added!");
                break;
            case 2:// update room details
                System.out.println("Which room would you like to update? (Enter the room number)");
                int count = 0;
                for (Room room1 : rooms) {
                    count++;
                    System.out.println(count + ". " + room1 + "\n");
                }
                String roomNumber = in.nextLine();

                for (Room room1 : rooms) {
                    if (roomNumber.equals(room1.getRoomNumber())) {
                        System.out.println("What would you like to update? (Enter a number)\n1.Price \n2.Amenities \n3.Bed Type");
                        int choice1 = in.nextInt();
                        in.nextLine();
                        
                        switch (choice1) {
                            case 1://update price
                                System.out.print("Enter the price: ");
                                double price = in.nextDouble();
                                room1.setPricePerNight(price);
                                System.out.println("Change successfull!");
                                break;
                            case 2://update amenities
                                String[] amenities = new String[4];
                                System.out.println("Enter the Amenities (Enter empty line to stop): ");
                                int i = 0;
                                System.out.print("1. ");
                                String amenities1 = in.nextLine();
                                while (!("".equals(amenities1)) & i < 4) {// allows the manager to add up to 4 amenities per room
                                    amenities[i] = amenities1;
                                    i++;
                                    System.out.print((i + 1) + ". ");
                                    amenities1 = in.nextLine();
                                }
                                room1.setAmenities(amenities);
                                System.out.println("Change successfull!");
                                break;
                            case 3://update bed type
                                System.out.print("Enter the bed type: ");
                                String bedType1 = in.nextLine();
                                room1.setBedType(bedType1);
                                System.out.println("Change successfull!");
                                break;
                            default:
                                System.out.println("Invalid choice!");
                        }
                        
                        notFound = false;
                    }
                }
                
                if(notFound)
                    System.out.println("Invalid room number!");
                
                break;
            case 3://remove a room
                notFound = true;
                System.out.println("Which room would you like to remove? (Enter the room number)");
                count = 0;
                for (Room room1 : rooms) {//lists all rooms
                    count++;
                    System.out.println(count + ". " + room1 + "\n");
                }
                String roomNumber1 = in.nextLine();

                for (Room room1 : rooms) {//finds room and removes it
                    if (roomNumber1.equals(room1.getRoomNumber())) {
                        rooms.remove(room1);
                        System.out.println("Room was removed!");
                        notFound = false;
                        break;
                    }
                }

                if(notFound)
                    System.out.println("Invalid room number!");
                
                break;
            default:
                System.out.println("Invalid choice!");
        }
    }

    public void UpdateRoomPricing(ArrayList<Room> rooms) {
        Scanner in = new Scanner(System.in);
        System.out.println("Which room type? (enter a number) \n1. Single \n2. Double \n3. Suite \n4. Deluxe");
        int choice = in.nextInt();
        System.out.print("Enter the price change for this room type: ");
        double price = in.nextDouble();

        switch (choice) {//finds the room type and sets price
            case 1:
                for (Room rooms1 : rooms) {
                    if ("Single".equals(rooms1.getRoomType())) {
                        rooms1.setPricePerNight(price);
                        System.out.println("Change successfull!");
                    }
                }
                break;
            case 2:
                for (Room rooms1 : rooms) {
                    if ("Double".equals(rooms1.getRoomType())) {
                        rooms1.setPricePerNight(price);
                        System.out.println("Change successfull!");
                    }
                }
                break;
            case 3:
                for (Room rooms1 : rooms) {
                    if ("Suite".equals(rooms1.getRoomType())) {
                        rooms1.setPricePerNight(price);
                        System.out.println("Change successfull!");
                    }
                }
                break;
            case 4:
                for (Room rooms1 : rooms) {
                    if ("Deluxe".equals(rooms1.getRoomType())) {
                        rooms1.setPricePerNight(price);
                        System.out.println("Change successfull!");
                    }
                }
                break;
            default:
                System.out.println("Invalid choice!");
        }
    }

