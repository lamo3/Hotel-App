                + "\n5. Request a service"
                + "\n6. View invoice and payment status"
                + "\n7. Make a payment"
                + "\n8. Submit feedback"
                + "\n9. Update contact information"
                + "\nEnter here: ");
        int choice = input.nextInt();
        input.nextLine();//clear buffer after nextInt

        while (choice != 0) { //the while loop insures that the user can do multiple services without having to restart the app multiple times
            switch (choice) {
                case 1:
                    System.out.println("--------------------------------------------------------------\n");

                    String checkInDate;
                    String checkOutDate;

                    boolean correct;
                    do {//to make sure that the dates arent invalid in any way
                        System.out.print("Enter a check in date(DD/MM/YYYY): ");
                        checkInDate = input.nextLine();
                        System.out.print("Enter a check out date(DD/MM/YYYY): ");
                        checkOutDate = input.nextLine();

                        if (Reservation.checkDates(checkInDate, checkOutDate)) {
                            correct = false;
                        } else {
                            System.out.println("Invalid dates! try again.");
                            correct = true;
                        }

                    } while (correct);

                    System.out.print("Enter the number of guests: ");
                    int noOfGuests = input.nextInt();

                    System.out.println("Rooms available: \n");

                    guest.SearchAvailableRooms(checkInDate, checkOutDate, noOfGuests, room, reservation);
                    break;
                case 2:
                    System.out.println("--------------------------------------------------------------\n");
                    System.out.println(" --- Make a Reservation --- ");

                    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy", Locale.ENGLISH);
                    LocalDate date = LocalDate.now(); // to give an accurate booking date
                    String dateNow = date.format(formatter);

                    do {
                        System.out.print("Enter a check in date(DD/MM/YYYY): ");
                        checkInDate = input.nextLine();
                        System.out.print("Enter a check out date(DD/MM/YYYY): ");
                        checkOutDate = input.nextLine();

                        if (Reservation.checkDates(checkInDate, checkOutDate)) {
                            correct = false;
                        } else {
                            System.out.println("Invalid dates! try again.");
                            correct = true;
                        }
                    } while (correct);

                    System.out.print("Enter the number of guests: ");
                    noOfGuests = input.nextInt();

                    input.nextLine();
                    System.out.print("Any special requests? ");
                    String specialRequests = input.nextLine();

                    System.out.println("Rooms available: "); // so the guest can choose a room that isn't reserved

                    guest.SearchAvailableRooms(checkInDate, checkOutDate, noOfGuests, room, reservation);
                    System.out.print("Which room would you like? (Enter the room number) \nEnter here: ");
                    String roomNumber = input.nextLine();

                    for (Room rooms : room) {
                        if (rooms.getRoomNumber().equals(roomNumber)) {
                            Reservation r = new Reservation(guest, checkInDate, checkOutDate, noOfGuests, specialRequests, dateNow, rooms);
                            reservation.add(r); //creates and adds a reseravtion to the arraylist
                            guest.getGuestReservation().add(r);//adds it to the list of reservations that the guest has made before
                            invoices.add(r.getInvoice());
                            System.out.println("Reservation confirmed! \nYour Reservation ID is: " + r.getReservationID());
                        }
                    }

                    StatsDocument();// to update hotel stats on the txt doc
                    break;
                case 3:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Cancel a Reservation --- ");
                    System.out.print("Enter your reservation ID: ");
                    String reservationID = input.nextLine();

                    boolean found = false;// to check if there are any reservations under the id

                    for (Reservation r : guest.getGuestReservation()) {
                        if (r.getReservationID().equals(reservationID)) {
                            r.setReservationStatus("Cancelled");
                            System.out.println("Cancellation successful!");
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("There is no reservation under this ID.");
                    }

                    StatsDocument();
                    break;
                case 4:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- View Reservation Details --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    found = false;

                    for (Reservation r : guest.getGuestReservation()) {
                        if (r.getReservationID().equals(reservationID)) {
                            System.out.println("\n" + r);
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("There is no reservation under this ID.");
                    }

                    break;
                case 5:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Request a Service --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    found = false;

                    for (Reservation r : guest.getGuestReservation()) {
                        if (r.getReservationID().equals(reservationID)) {

                            Service s = r.requestAService();
                            services.add(s);//service is added to the list of all the services requested in the hotel
                            r.getInvoice().setServiceCharges(r.getService());//calculate service charges
                            r.getInvoice().setTaxAmount();//calculate tax amount including service
                            r.getInvoice().calculateTotalAmount();//calculate total amount including service

                            System.out.println("Request successful!");
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("There is no reservation under this ID.");
                    }

                    StatsDocument();
                    break;
                case 6:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- View Invoice and Payment Status --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    found = false;

                    for (Reservation r : guest.getGuestReservation()) {
                        if (r.getReservationID().equals(reservationID)) {
                            System.out.println();
                            guest.ViewInvoice(r);
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("There is no reservation under this ID.");
                    }

                    break;
                case 7:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Make a Payment --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    found = false;

                    for (Reservation r : guest.getGuestReservation()) {
                        if (r.getReservationID().equals(reservationID)) {//uses reservation ID to identify which invoice to view and pay
                            guest.MakeAPayment(r);
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("There is no reservation under this ID.");
                    }

                    StatsDocument(); // to update hotel stats on the txt doc
                    break;

                case 8:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Submit Feedback --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    found = false;

                    for (Reservation r : guest.getGuestReservation()) {
                        if (r.getReservationID().equals(reservationID)) {

                            r.submitGuestFeedback();
                            feedBacks.add(r.getGuestFeedBack());//adds fedback to the list of feedbacks made about the hotel

                            System.out.println("Feedback submitted successfully!");
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("There is no reservation under this ID.");
                    }

                    StatsDocument();
                    break;
                case 9:
                    guest.updateupdateContactInfo();//if the guest wants to edit any personal info

                    StatsDocument();// to update hotel stats on the txt doc

                    break;
                default:
                    System.out.println("Invalid option!");
            }

            System.out.println("--------------------------------------------------------------");
            System.out.print("\nWould you like to do anything else?(Enter a number; 0 to exit)"
                    + "\n1. Search for available rooms "
                    + "\n2. Make a reservation"
                    + "\n3. Cancel a reservation"
                    + "\n4. View reservation details"
                    + "\n5. Request a service"
                    + "\n6. View invoice and payment status"
                    + "\n7. Make a payment"
                    + "\n8. Submit feedback"
                    + "\n9. Update contact information"
                    + "\nEnter here: ");
            choice = input.nextInt();
            input.nextLine();//clear buffer after nextInt
        }
    }

