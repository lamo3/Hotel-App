    public void generateRevenueReport(ArrayList<Reservation> reservation) {// this method takes an ArrayList, where each reservation includes a room invoice and a list of guest services.
        System.out.println("--- Please enter the reporting period ---");
        System.out.print("Enter start date (YYYY-MM-DD): ");
        LocalDate startDate = LocalDate.parse(input.next());
        System.out.print("Enter end date (YYYY-MM-DD): ");
        LocalDate endDate = LocalDate.parse(input.next());
        
        // FIXED: Formatter to match the DD/MM/YYYY format used in your Reservation objects
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy", Locale.ENGLISH);

        double totalRevenue = 0;
        int totalOccupancyRooms = 0;
        int totalRooms = 0;
        int totalServiceUsage = 0;
        int totalOutstandingPayment = 0;

        for (Reservation r : reservation) {
            // FIXED: Parsing logic now uses the formatter to avoid the crash
            LocalDate checkIn = LocalDate.parse(r.getCheckInDate(), formatter);
            LocalDate checkOut = LocalDate.parse(r.getCheckOutDate(), formatter);

            // Checking if the reservation falls within the input range
            if ((checkIn.isAfter(startDate) || checkIn.isEqual(startDate)) && 
                (checkOut.isBefore(endDate) || checkOut.isEqual(endDate))) {

                totalRevenue += r.getInvoice().getTotalAmount();

                // FIXED: Check the room status string correctly
                if ("Occupied".equalsIgnoreCase(r.getRoom().getRoomStatus())) {
                    totalOccupancyRooms++;
                }
                totalRooms++;
                
                ArrayList<Service> serviceList = r.getService();
                totalServiceUsage += serviceList.size();
                
                if ("Unpaid".equalsIgnoreCase(r.getInvoice().getPaymentStatus())) {
                    totalOutstandingPayment++;
                }
            }
        }
        
        System.out.println("\n ------ Revenue Report ----- ");
        System.out.println(" Period [" + startDate + " to " + endDate + "]");
        System.out.println("******************************");
        System.out.println("Total Revenue : " + totalRevenue);
        
        // FIXED: Percentage calculation logic
        if (totalRooms > 0) {
            double rate = ((double) totalOccupancyRooms / totalRooms) * 100;
            System.out.println("Occupancy Rates: " + rate + "%");
        } else {
            System.out.println("Occupancy Rates: 0% (No data for this period)");
        }
        
        System.out.println("Total Service Usage : " + totalServiceUsage);
        System.out.println("Outstanding Payments : " + totalOutstandingPayment);
        System.out.println("******************************");

    }

    // lamia method
