package hotelappfinal;

import java.util.*;
import java.time.LocalDate;// to get real date
import java.time.format.DateTimeFormatter;//to custmize format of localdate
import java.time.temporal.ChronoUnit;


/**
 *
 * @author lamyaalhamad
 */
public class Invoice {

    private String invoiceID;
    private String associatedReservationID;
    private String associatedGuestID;
    private double roomCharges;
    private String invoiceDate;
    private double serviceCharges;
    private double taxAmount;
    private double discountAmount;
    private double totalAmount;
    private String paymentStatus;
    private String paymentMethod;
    private static int invoiceCounter; //to keep track of number of invoices and helps with generating ID

    public Invoice(String reservationID, double price, String checkInDate, String checkOutDate, ArrayList<Service> services, String guestID) {
        invoiceCounter++;
        
        setInvoiceID();
        associatedReservationID = reservationID;
        setRoomCharges(price, checkInDate, checkOutDate);
        setInvoiceDate(checkOutDate);
        setServiceCharges(services);
        setTaxAmount();
        calculateTotalAmount();
        paymentStatus = "Unpaid";
        paymentMethod = "Not chosen";
        associatedGuestID = guestID;
    }

    public void setInvoiceID() {//uses the ounter to generate ID
        this.invoiceID = "IV00" + invoiceCounter;
    }

    public void setRoomCharges(double price, String checkInDate, String checkOutDate) {//uses checkin/out dates to calculate total room charges
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy", Locale.ENGLISH);//to change the format of the date so that theyre all the same and dont give an error
        LocalDate start = LocalDate.parse(checkInDate, formatter);//changes date from string to localdate
        LocalDate end = LocalDate.parse(checkOutDate, formatter);//changes date from string to localdate
        long numberOfDays = start.until(end, ChronoUnit.DAYS); // to get number of days stayed
        
        roomCharges = price*numberOfDays;
    }

    public void setInvoiceDate(String checkOutDate) {
        this.invoiceDate = checkOutDate;
    }

    public void setServiceCharges(ArrayList<Service> services) {
        serviceCharges = 0;   // reset first so the charges dont double
        for(Service service: services){//to get total service charges for the guest
            serviceCharges += service.getPrice();
        }
    }

    public void setTaxAmount() {
        taxAmount = (roomCharges+serviceCharges)*0.15;
    }

    public void setDiscountAmount(boolean discount) {
        if (discount) {
            discountAmount = (roomCharges+serviceCharges)*0.10;
        }
        
        else
            discountAmount = 0;
    }

    public void calculateTotalAmount() {
        totalAmount = roomCharges+serviceCharges+taxAmount-discountAmount;
    }

    public void setTotalAmount(double total) {
        if(total >= 0)
            totalAmount = total;
        else
            System.out.println("Invalid!");
    }
    
    public void setPaymentStatus(String paymentStatus) {
        switch(paymentStatus){
            case "Unpaid":
            case "Paid":
            case "Partially Paid":
                this.paymentStatus = paymentStatus;
                break;
            default :
                System.out.println("Invalid payment status!");
        }
    }

    public void setPaymentMethod(String paymentMethod) {
        switch (paymentMethod) {
            case "Cash":
            case "Card":
            case "Online Transfer":
                this.paymentMethod = paymentMethod;
                break;
            default :
                System.out.println("Invalid payment method!");
        }
    }

    public String getInvoiceID() {
        return invoiceID;
    }

    public String getAssociatedReservationID() {
        return associatedReservationID;
    }

    public String getAssociatedGuestID() {
        return associatedGuestID;
    }

    public double getRoomCharges() {
        return roomCharges;
    }

    public String getInvoiceDate() {
        return invoiceDate;
    }

    public double getServiceCharges() {
        return serviceCharges;
    }

    public double getTaxAmount() {
        return taxAmount;
    }

    public double getDiscountAmount() {
        return discountAmount;
    }

    public double getTotalAmount() {
        return totalAmount;
    }

    public String getPaymentStatus() {
        return paymentStatus;
    }

    public String getPaymentMethod() {
        return paymentMethod;
    }

    public static int getInvoiceCounter() {
        return invoiceCounter;
    }

    //used to help the guest view invoice
    @Override
    public String toString() {
        return "Invoice ID: " + invoiceID + "\nReservation ID: " + associatedReservationID + "\nGuest ID: " + associatedGuestID + "\nRoom charges: " + roomCharges + "\nService charges: " + serviceCharges + "\nTax amount (15%): " + taxAmount + "\nDiscount amount (10%): " + discountAmount + "\nTotal amount left: " + totalAmount + "\nPayment status: " + paymentStatus + "\nPayment method: " + paymentMethod;
    }
}
