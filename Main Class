    public static void main(String[] args) {
        
        System.out.println("----- Welcome to our Hotel App! -----");
        System.out.print("1. Login to your existing account \n2. Create an account and sign up \nChoose a number: ");
        int choice = input.nextInt();

        switch (choice) {
            case 1: //this case is used if the user already has an account
                System.out.print("Enter your email or phone number: ");
                String emailOrPhone = input.nextLine();
                for (User user : users) {
                    if (emailOrPhone == user.getUserEmail() | emailOrPhone == user.getUserPhone()) { //checks if there is an account under the given email/phone in the user arraylist
                        System.out.println("Login successfull!");
                        switch (user.getRole()) {
                            case "Guest":
                                Guest g = (Guest) user; //used to make sure that the details of current user is used and not a past user
                                Guest(users, g); //if the user is a guest they will be taken to the guest module
                                break;
                            case "Receptionist":
                                Receptionist r = (Receptionist) user; //used to make sure that the details of current user is used and not a past user
                                Receptionist(users, r); //if the user is a receptionist they will be taken to the receptionist module
                                break;
                            case "Manager":
                                Manager m = (Manager) user; //used to make sure that the details of current user is used and not a past user
                                Manager(users, m); //if the user is a manager they will be taken to the manager module
                                break;
                        }
                    } else {
                        System.out.println("There is no account under this email/phone number!");
                    }
                }
                break;
            case 2: //this case is used when the user is creating a new account
