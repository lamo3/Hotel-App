    //used by the guest to pay their invoice
    public void MakeAPayment(Reservation r) {
        if (r.getInvoice().getPaymentStatus() == "Unpaid") { //check that the payment is unpaid
            System.out.print("Choose a payment method: \n1.Cash \n2.Card \n3.Online Transfer");
            int paymentChoice = input.nextInt();

            switch (paymentChoice) { //set the payment method based on choice
                case 1:
                    r.getInvoice().setPaymentMethod("Cash");
                    break;
                case 2:
                    r.getInvoice().setPaymentMethod("Card");
                    break;
                case 3:
                    r.getInvoice().setPaymentMethod("Online Transfer");
                    break;
                default:
                    System.out.println("Invalid payment method!");
            }

            System.out.print("How much would you like to pay?");
            double payment = input.nextDouble();

            while (payment < 0 | payment > r.getInvoice().getTotalAmount()) { // makes sure that the guest doesnt enter a number that is too much or too little
                if (payment > r.getInvoice().getTotalAmount()) {
                    System.out.println("That exceeds your bills!");
                } else {
                    System.out.println("That is an invalid amount!");
                }

                System.out.println("Try again!");
                payment = input.nextDouble();
            }

            if (payment == r.getInvoice().getTotalAmount()) { //status changes based on amount
                r.getInvoice().setPaymentStatus("Paid");
            } else if (payment < r.getInvoice().getTotalAmount() & payment > 0) {
                r.getInvoice().setPaymentStatus("Partially Paid");
            }

            System.out.println("Payment succefull!");
            ViewInvoice(r); //view invoice after payment
        }
    }
