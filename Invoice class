package hotelapp;

/**
 *
 * @author lamyaalhamad
 */
public class Invoice {

    private String invoiceID;
    private Reservation associatedReservation;
    private String associatedReservationID;
    private String associatedGuestID;
    private double roomCharges;
    private String invoiceDate;
    private Service associatedService;
    private double serviceCharges;
    private double taxAmount;
    private double discountAmount;
    private double totalAmount;
    private String paymentStatus;
    private String paymentMethod;
    private User user;
    private static int invoiceCounter;

    public Invoice(Reservation associatedReservation, Service associatedService, String paymentMethod, User user, boolean discount) {
        setInvoiceID();
        setAssociatedReservation(associatedReservation);
        setAssociatedReservationID();
        setAssociatedGuestID();
        setRoomCharges();
        setInvoiceDate();
        setAssociatedService(associatedService);
        setServiceCharges();
        setTaxAmount();
        setTotalAmount();
        paymentStatus = "Unpaid";
        setPaymentMethod(paymentMethod);
        setDiscountAmount(discount);

        invoiceCounter++;
    }

    public void setInvoiceID() {
        this.invoiceID = "IV00" + invoiceCounter;
    }

    public void setAssociatedReservation(Reservation associatedReservation) {
        if (associatedReservation.getUser().getUserId() == user.getUserId() & user.getRole() == "Guest" & associatedReservation != null) {
            this.associatedReservation = associatedReservation;
        } else {
            System.out.println("Invalid reservation!");
        }
    }

    public void setAssociatedGuestID() {
        associatedGuestID = associatedReservation.getAssociatedGuestID();
    }

    public void setAssociatedReservationID() {
        associatedReservationID = associatedReservation.getReservationID();
    }

    public void setRoomCharges() {
        int checkInDay = Integer.parseInt(associatedReservation.getCheckInDate().substring(0, 3));
        int checkOutDay = Integer.parseInt(associatedReservation.getCheckOutDate().substring(0, 3));
        int numberOfDays = checkOutDay - checkInDay;

        roomCharges = associatedReservation.getRoom().getPricePerNight() * numberOfDays;
    }

    public void setInvoiceDate() {
        invoiceDate = associatedReservation.getCheckOutDate();
    }

    public void setAssociatedService(Service associatedService) {
        if (associatedService.getReservationId() == associatedReservationID & associatedService != null) {
            this.associatedService = associatedService;
        } else {
            System.out.println("Invalid Service!");
        }

    }

    public void setServiceCharges() {
        Guest g;
        if (user instanceof Guest) {
            g = (Guest) user;
            for (Service services : g.getGuestService()) {
                serviceCharges += services.getPrice();
            }
        }
    }

    public void setTaxAmount() {
        taxAmount = (roomCharges + serviceCharges) * 0.15;
    }

    public void setDiscountAmount(boolean discount) {
        if (discount) {
            discountAmount = (roomCharges + serviceCharges) * 0.10;
        } else {
            discountAmount = 0;
        }
    }

    public void setTotalAmount() {
        totalAmount = roomCharges + serviceCharges + taxAmount;
    }

    public void setPaymentStatus(String paymentStatus) {
        switch (paymentStatus) {
            case "Unpaid":
            case "Paid":
            case "Partially Paid":
                this.paymentStatus = paymentStatus;
                break;
            default:
                System.out.println("Invalid payment status!");
        }
    }

    public void setPaymentMethod(String paymentMethod) {
        switch (paymentMethod) {
            case "Cash":
            case "Card":
            case "Online Transfer":
                this.paymentMethod = paymentMethod;
                break;
            default:
                System.out.println("Invalid payment method!");
        }
    }

    public String getInvoiceID() {
        return invoiceID;
    }

    public Reservation getAssociatedReservation() {
        return associatedReservation;
    }

    public String getAssociatedReservationID() {
        return associatedReservationID;
    }

    public double getRoomCharges() {
        return roomCharges;
    }

    public String getInvoiceDate() {
        return invoiceDate;
    }

    public Service getAssociatedService() {
        return associatedService;
    }

    public double getServiceCharges() {
        return serviceCharges;
    }

    public double getTaxAmount() {
        return taxAmount;
    }

    public double getDiscountAmount() {
        return discountAmount;
    }

    public double getTotalAmount() {
        return totalAmount;
    }

    public String getPaymentStatus() {
        return paymentStatus;
    }

    public String getPaymentMethod() {
        return paymentMethod;
    }

    @Override
    public String toString() {
        return "Invoice ID: " + invoiceID + "\nReservation ID: " + associatedReservationID + "\nGuest ID: " + user.getUserId() + "\nRoom charges: " + roomCharges + "\nService charges: " + serviceCharges + "\nTax amount (15%): " + taxAmount + "\nDiscount amount (10%): " + discountAmount + "\nTotal amount: " + totalAmount + "\nPayment status: " + paymentStatus + "\nPayment method: " + paymentMethod;
    }

}
