package hotelapp;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.LinkedList;
import java.util.Scanner;



public class Manager extends User{
    
    Scanner input=new Scanner(System.in);
    public Manager(String userId, String userJoiningDate, String userName, String userEmail, String userPhone, String userAddress, String role) {
        super(userId, userJoiningDate, userName, userEmail, userPhone, userAddress, role);
    }
    
    
    public void generateRevenueReport(ArrayList<Reservation>reservation){//reservation has a room,invoice and Arraylist of service
        System.out.println("--- Please enter the reporting period ---");
        System.out.println("Enter start date (YYYY-MM-DD). ");
        LocalDate startDate=LocalDate.parse(input.next());
        System.out.println("Enter end date (YYYYMMDD). ");
        LocalDate endDate=LocalDate.parse(input.next());
        double totalRevenue=0;
        int totalOccupancyRooms=0;
        int totalRooms=0;
        int totalServiceUsage=0;
        int totalOutstandingPayment=0;
        for(Reservation r:reservation){
            LocalDate cheackIn=LocalDate.parse(r.getCheckInDate());
            LocalDate checkOut=LocalDate.parse(r.getCheckOutDate());
           if(cheackIn.isAfter(startDate)||cheackIn.isEqual(startDate)&&checkOut.isBefore(endDate)||checkOut.isEqual(endDate)){
             
             totalRevenue+=r.getInvoice().getTotalAmount();
            
             
             if(r.getRoom().equals("Occupied")){
                 totalOccupancyRooms++;
             }
            totalRooms++;
            ArrayList<Service> service=r.getService();
             totalServiceUsage+=service.size();
             if(r.getInvoice().getPaymentStatus().equals("Unpaid"))
                 totalOutstandingPayment++;
                 
            }
        }
            System.out.println(" ------ Revenue Report ----- ");
            System.out.println(" Period ["+startDate+" to "+endDate+"]");
            System.out.println("******************************");
            System.out.println("Total Revenue : "+totalRevenue);
            System.out.println("Occupancy Rates "+(totalOccupancyRooms/totalRooms*100)+"%");
            System.out.println("Total Service Usage : "+totalServiceUsage);
            System.out.println("Outstanding Payments : "+totalOutstandingPayment);
            System.out.println("******************************");
            
            }
    
    
    
    // lamia method
     public void ManageRoomInventory(LinkedList<Room> rooms) {
        Scanner in = new Scanner(System.in);

        System.out.println("Would you like to (Enter a number): \n1.Add a new room? \n2.Update room details? \n3.Remove a room?");
        int choice = in.nextInt();

        switch (choice) {
            case 1:
                System.out.print("Enter the following: \nRoom Type: ");
                String roomType = in.nextLine();
                System.out.print("\nFloor Number: ");
                int floorNumber = in.nextInt();
                System.out.println("\nBed Type: ");
                String bedType = in.nextLine();
                rooms.add(new Room(roomType, floorNumber, bedType));
                break;
            case 2:
                System.out.println("Which room would you like to update? (Enter the room number)");
                for (Room room1 : rooms) {
                    System.out.println(room1);
                }
                String roomNumber = in.nextLine();

                for (Room room1 : rooms) {
                    if (roomNumber == room1.getRoomNumber()) {
                        System.out.println("What would you like to update? (Enter a number)\n1.Price \n2.Amenities \n3.Bed Type");
                        int choice1 = in.nextInt();
                        switch (choice1) {
                            case 1:
                                System.out.print("Enter the price: ");
                                double price = in.nextDouble();
                                room1.setPricePerNight(price);
                                break;
                            case 2:
                                String[] amenities = new String[4];
                                System.out.print("Enter the Amenities: \n1. ");
                                String amenities1 = in.nextLine();
                                int i = 0;
                                while (amenities1 == null | amenities1 == "") {
                                    amenities[i] = amenities1;
                                    i++;
                                    System.out.print((i + 1) + ". ");
                                    amenities1 = in.nextLine();
                                }
                                room1.setAmenities(amenities);
                                break;
                            case 3:
                                System.out.print("Enter the bed type: ");
                                String bedType1 = in.nextLine();
                                room1.setBedType(bedType1);
                            default:
                                System.out.println("Invalid choice!");
                        }
                    }
                }
                break;
            case 3:
                System.out.println("Which room would you like to remove? (Enter the room number)");
                for (Room room1 : rooms) {
                    System.out.println(room1);
                }
                String roomNumber1 = in.nextLine();

                for (Room room1 : rooms) {
                    if (roomNumber1 == room1.getRoomNumber()) {
                        rooms.remove(room1);
                    }
                }

                break;
            default:
                System.out.println("Invalid choice!");
        }
    }

    public void UpdateRoomPricing(LinkedList<Room> rooms) {
        Scanner in = new Scanner(System.in);
        System.out.println("Which room type? (enter a number) \n1. Single \n2. Double \n3. Suite \n4. Deluxe");
        int choice = in.nextInt();
        System.out.print("Enter the price change for this room type: ");
        double price = in.nextDouble();

        switch (choice) {
            case 1:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Single") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            case 2:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Double") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            case 3:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Suite") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            case 4:
                for (Room rooms1 : rooms) {
                    if (rooms1.getRoomType() == "Deluxe") {
                        rooms1.setPricePerNight(price);
                    }
                }
                break;
            default:
                System.out.println("Invalid choice!");
        }
    }

}
        
        
    
    

    

