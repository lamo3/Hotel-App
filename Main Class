    public static void viewHotalStatistics() {
        System.out.println("Total number of rooms : " + room.size());
        System.out.println("Total number of Reservation : " + reservation.size());
        System.out.println(" Total number of guests : " + guest.size());
        System.out.println("--------------------------------------------------------------");
        System.out.println("Rooms by status : ");
        int statuAvailableCount = 0;
        int statuOccupiedCount = 0;
        int statuUnderMaintenanceCount = 0;
        int statuReservedCount = 0;
        for (Room r : room) {
            switch (r.getRoomStatus()) {
                case "Available":
                    statuAvailableCount++;
                    break;
                case "Occupied":
                    statuOccupiedCount++;
                    break;
                case "Under Maintenance":
                    statuUnderMaintenanceCount++;
                    break;
                case "Reserved":
                    statuReservedCount++;
                    break;
            }

        }
        System.out.println("Available : " + statuAvailableCount);
        System.out.println("Occupied : " + statuOccupiedCount);
        System.out.println("Under Maintenance : " + statuUnderMaintenanceCount);
        System.out.println("Reserved : " + statuReservedCount);

        System.out.println("Room by type : ");
        int typeSingle = 0;
        int typeDouble = 0;
        int typeSuite = 0;
        int typeDeluxe = 0;

        for (Room rr : room) {
            switch (rr.getRoomType()) {
                case "Single":
                    typeSingle++;
                    break;
                case "Double":
                    typeDouble++;
                    break;
                case "Suite":
                    typeSuite++;
                case "Deluxe":
                    typeDeluxe++;
                    break;

            }

        }
        System.out.println("Single Rooms : " + typeSingle);
        System.out.println("Double Rooms : " + typeDouble);
        System.out.println("Suite Rooms : " + typeSuite);
        System.out.println("Deluxe Rooms " + typeDeluxe);

        double occupancyRate = (double) statuOccupiedCount / room.size();
        System.out.println("Occupancy Rate : " + occupancyRate + "% ");
    }

    public static void StatsDocument() { // to save hotel stats on a txt doc
        
        try {
            PrintWriter print = new PrintWriter("/Users/lamyaalhamad/Desktop/NetBeans/HotelAppFinal");
            
            ListIterator<Room> it1 = room.listIterator();
            print.println("=== Rooms in the Hotel ==="); // prints all the rooms
            int i = 1;
            while (it1.hasNext()) {
                print.println(i + ". " + it1.next());
                i++;
            }
            
            ListIterator<Reservation> it2 = reservation.listIterator();
            print.println("=== Rservations Made ==="); // prints all the reservations
            int j = 1;
            while (it2.hasNext()) {
                print.println(j + ". " + it2.next());
                j++;
            }
            
            ListIterator<Service> it3 = services.listIterator();
            print.println("=== Services requested ===");// prints all the services
            int h = 1;
            while (it3.hasNext()) {
                print.println(h + ". " + it3.next() + "\n");
                h++;
            }
            
            ListIterator<FeedBack> it4 = feedBacks.listIterator();
            print.println("=== Feedacks Sent ===");// prints all the feedbacks
            int s = 1;
            while (it4.hasNext()) {
                print.println(s + ". " + it4.next() + "\n");
                s++;
            }
            
            int m = 0;
            int r = 0;
            int g = 0;
            for(User user: users){
                
                print.println("=== Managers in the hotel ===");// prints all the manager
                if(user instanceof Manager){
                    print.println(user);
                    m++;
                }
                
                print.println("=== Receptionist in the hotel ===");// prints all the receptionists
                if (user instanceof Receptionist) {
                    print.println(user);
                    r++;
                }
                
                print.println("=== Guests in the hotel ===");// prints all the guests
                if (user instanceof Guest){
                    print.println(user);
                    g++;
                }
            }
            
            ListIterator<Invoice> it5 = invoices.listIterator();
            print.println("=== Invoices ===");// prints all the invoices
            int x = 1;
            while (it5.hasNext()) {
                print.println(x + ". " + it5.next() + "\n");
                x++;
            }
            
            print.println("Total stats:" //prints the totals
                    + "\nNumber of Rooms: " + Room.getRoomCounter()
                    + "\nNumber of Reservations (Past and current): " + Reservation.getReservationCounter()
                    + "\nNumber of Services: " + services.size()
                    + "\nNumber of Feedbacks: " + feedBacks.size()
                    + "\nNumber of User: " + users.size()
                    + "\nNumber of Managers: " + m
                    + "\nNumber of Receptionists: " + r
                    + "\nNumber of Guests: " + g
                    + "\nNumber of Invoices: " + Invoice.getInvoiceCounter());
        } 
        
        catch (FileNotFoundException e) {
            System.out.println(e.getMessage());
        }
        
    }
