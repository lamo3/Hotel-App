                                + "\n1. Name"
                                + "\n2. Email"
                                + "\n3. Phone number"
                                + "\n4. Address"
                                + "\nEnter here: ");
                        choice = in.nextInt();
                        in.nextLine();
                        
                        switch (choice) {
                            case 1:// edit name
                                System.out.print("Enter a new name: ");
                                name = in.nextLine();
                                user.setUserName(name);
                                break;
                            case 2:// edit email
                                System.out.print("Enter a new email: ");
