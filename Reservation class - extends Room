    @Override
    public String toString() { // to display details of the reservation
        return room + "\nCheck in date: " + checkInDate + "\nCheck out date: " + checkOutDate + "\nNumber of guests: " + numberOfGuests + "\nReservation ID: " + reservationID + "\nReservation status: " + reservationStatus + "\nSpecial request: " + specialRequests;
    }

    @Override
    public int compareTo(Reservation other) { //orders reservations based on price in ascending order
        if (other.getRoom().getPricePerNight() > this.getRoom().getPricePerNight()) {
            return -1;
        } else if (other.getRoom().getPricePerNight() < this.getRoom().getPricePerNight()) {
            return 1;
        } else {
            return 0;
        }
    }

    public void cheackOut() {// halah add
        if (this.reservationStatus.equals("Cheacked-In")) {
            setReservationStatus("Checked-Out");
            getRoom().setRoomStatus("Available");
            double finalInvoice = getInvoice().getTotalAmount();
            System.out.println("Final Invoice : " + finalInvoice);
        }

    }

    public void registerGuestArrival() { //  halah add
        System.out.println("-----------------------------------");
        if (this.reservationStatus.equals("Confirmed")) {
            setReservationStatus("Cheacked-In");
            getRoom().setRoomStatus(("Occupied"));
            System.out.println("Guest has been cheacked in successfully! ");

        } else {
            System.out.println("Cannot Cheack In. The reservation is not confrimed. ");
        }
        System.out.println("-----------------------------------");
    }

    public Service requestAService() {// halah add

        System.out.println("--------------------------------------------------------------");
        System.out.println("Please select a service : ");
        System.out.println("1- Room Service. ");
        System.out.println("2- Laundry. ");
        System.out.println("3- Spa. ");
        System.out.println("4- Airport Shuttle. ");
        System.out.println("--------------------------------------------------------------");

        int guestServiceRequest = input.nextInt();
        String serviceId = "SI" + countS;
        countS++;

        switch (guestServiceRequest) {
            case 1:
                addService(new Service(serviceId, "Room Service", "Delivery service to the guest room", 80.75, this.reservationID, LocalDate.now().toString(), "Requested"));
                return (new Service(serviceId, "Room Service", "Delivery service to the guest room", 80.75, this.reservationID, LocalDate.now().toString(), "Requested"));

            case 2:
                addService(new Service(serviceId, "Laundry", "Washing clothes", 90.3, this.reservationID, LocalDate.now().toString(), "Requested"));
                return (new Service(serviceId, "Laundry", "Washing clothes", 90.3, this.reservationID, LocalDate.now().toString(), "Requested"));

            case 3:
                addService(new Service(serviceId, "Spa", "Spa service", 180.5, this.reservationID, LocalDate.now().toString(), "Requested"));
                return (new Service(serviceId, "Spa", "Spa service", 180.5, this.reservationID, LocalDate.now().toString(), "Requested"));

            case 4:
                addService(new Service(serviceId, "Airport Shuttle", "Airport transport", 110, this.reservationID, LocalDate.now().toString(), "Requested"));
                return (new Service(serviceId, "Airport Shuttle", "Airport transport", 110, this.reservationID, LocalDate.now().toString(), "Requested"));

            default:
                System.out.println(" Sorry. The option you entered is not available! ");

        }
        return null;

    }

    public FeedBack submitGuestFeedback() {// halah add 
        if (this.reservationStatus.equals("Checked-Out")) {
            String feedbackId = "FI" + countF;
            countF++;
            System.out.println("--------------------------------------------------------------");
            System.out.println("Please enter your rating number : ");
            int rating = input.nextInt();
            System.out.println("Please enter your comments : --optional--");
            String comment = input.nextLine();
            System.out.println("Thank you for your valuable feedback. We look forward to serving you again!");
            if (comment != null && !comment.equals("")) {
                setGuestFeedBack(new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, comment, LocalDate.now().toString()));
                return new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, comment, LocalDate.now().toString());
            } else {
                setGuestFeedBack(new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, LocalDate.now().toString()));
                return new FeedBack(feedbackId, this.associatedGuestID, this.reservationID, rating, LocalDate.now().toString());

            }

        }
        return null;

    }
    
