                        String yesOrNo = input.next();

                        if (yesOrNo.toLowerCase().equals("yes")) {
                            System.out.println("Login successfull!");
                            switch (user.getRole()) {
                                case "Guest":
                                    Guest g = (Guest) user; //used to make sure that the details of current user is used and not a past user
                                    Guest(users, g); //if the user is a guest they will be taken to the guest module
                                    break;
                                case "Receptionist":
                                    Receptionist r = (Receptionist) user; //used to make sure that the details of current user is used and not a past user
                                    Receptionist(users, r); //if the user is a receptionist they will be taken to the receptionist module
                                    break;
                                case "Manager":
                                    Manager m = (Manager) user; //used to make sure that the details of current user is used and not a past user
                                    Manager(users, m); //if the user is a manager they will be taken to the manager module
                                    break;
                            }
                        }

                        else
                            System.out.println("Thank you for using our hotel app!"); // app stops
                    }
                }

                switch (role) {
                    case 1:
                        users.add(new Guest(ID, dateString, name, email, phone, address, "Guest")); 
                        System.out.println("Sign in successfull!");
                        StatsDocument();// to update hotel stats on the txt doc
                        Guest(users, (Guest) users.getLast()); //creates and adds a new user/guest to the user arraylist and takes the user to the guest module
                        break;
                    case 2:
                        users.add(new Receptionist(ID, dateString, name, email, phone, address, "Receptionist"));
                        System.out.println("Sign in successfull!"); 
                        StatsDocument();// to update hotel stats on the txt doc
                        Receptionist(users, (Receptionist) users.getLast()); //creates and adds a new user/receptionist to the user arraylist and takes the user to the receptionist module
