    @Override
    public String toString() { // to display details of the reservation
        return room + "\nCheck in date: " + checkInDate + "\nCheck out date: " + checkOutDate + "\nNumber of guests: " + numberOfGuests + "\nReservation ID: " + reservationID + "\nReservation status: " + reservationStatus + "\nBooking Date: " + bookingDate + "\nSpecial request: " + specialRequests;
    }

    @Override
    public int compareTo(Reservation other) { //orders reservations based on price in ascending order
        if (other.getRoom().getPricePerNight() > this.getRoom().getPricePerNight()) {
            return -1;
        } else if (other.getRoom().getPricePerNight() < this.getRoom().getPricePerNight()) {
            return 1;
        } else {
            return 0;
        }
    }

    public void cheackOut() {// halah add
        if (this.reservationStatus.equals("Checked-In")) {// To ensure that the reservation status is "Cheacked-in".
            setReservationStatus("Checked-Out");// using the setter to update the status into "Cheacked-out"
            getRoom().setRoomStatus("Available");// Changeing the room status to available.
            double finalInvoice = getInvoice().getTotalAmount();
            System.out.println("Final Invoice : " + finalInvoice);
        }

    }

    public void registerGuestArrival() { //  halah add
        System.out.println("-----------------------------------");
        if (this.reservationStatus.equals("Confirmed")) {// To ensure that the reservation status is "Confirmed".
            setReservationStatus("Checked-In");// using setters to cahnge reservation status into "Cheacked-In".
            getRoom().setRoomStatus(("Occupied"));// Changeing the room status to Occupied.
            System.out.println("Guest has been checked in successfully! ");

        } else {
            System.out.println("Cannot Check In. The reservation is not confrimed. ");
        }
        System.out.println("-----------------------------------");
    }

