    private static int countF = 1;// Hlaha dd

    public Reservation(User user, String CheckInDate, String CheckOutDate, int NumberOfGuests, String SpecialRequests, String BookingDate, Room room) {
        
        reservationCounter++;
        room.setRoomStatus("Reserved");
        setReservationID();
        setRoom(room);
        setAssociatedGuestID(user);
        setCheckInDate(checkDates(CheckInDate, CheckOutDate), CheckInDate);
        setCheckOutDate(checkDates(CheckInDate, CheckOutDate), CheckOutDate);
        setNumberOfGuests(NumberOfGuests);
        setSpecialRequests(SpecialRequests);
        setBookingDate(BookingDate);
        reservationStatus = "Confirmed";

        invoice = new Invoice(reservationID, room.getPricePerNight(), CheckInDate, CheckOutDate, services, user.getUserId());//auto generates an ivoice upon creating reservation
        allInvoices.add(invoice);
    }

    public static ArrayList<Invoice> getAllInvoices() {
        return allInvoices;
    }

    public void setReservationID() {// uses counter to autogenerate the id
        this.reservationID = "R00" + reservationCounter;
    }

    public void setCurrentService(Service service) {// sets last service requested
        if(services.isEmpty())
            service = null;
        else
           service = services.getLast();
        
    }

    public Service getCurrentService() {
        return service;
    }

    public void setAssociatedGuestID(User user) {//makes sure that the user is a guest
        if (!(user.getRole().equals("Guest"))) {
            System.out.println("Invalid guest ID!");
        } else {
            associatedGuestID = user.getUserId();
        }
    }

    
    public void setCheckInDate(Boolean check, String CheckInDate) {
        if(check)
            checkInDate = CheckInDate;
        else
            System.out.println("invalid check in date!");
    }

    
    public void setCheckOutDate(Boolean check, String CheckOutDate) {
        if(check)
            checkOutDate = CheckOutDate;
        else
            System.out.println("invalid check out date!");
    }
    

    public void setNumberOfGuests(int NumberOfGuests) {// ensure number of guests isnt more than the max occupancy of the room
        if (NumberOfGuests >= 1 & NumberOfGuests <= room.getMaxOccupancy()) {
            numberOfGuests = NumberOfGuests;
        } else {
            System.out.println("Invalid number of guests!");
        }
    }

    //Used by receptionist to change when the guest come and by the guest to cancel their reservation
    public void setReservationStatus(String ReservationStatus) {
        switch (ReservationStatus.toLowerCase()) {
            case "confirmed":
            case "checked-Out":
            case "checked-In":
            case "cancelled":
            case "no-show":
                reservationStatus = ReservationStatus;
                break;
            default:
                System.out.println("Invalid reservation status!");
        }

    }

    public void setSpecialRequests(String SpecialRequests) {
        specialRequests = SpecialRequests;
    }

    public void setBookingDate(String BookingDate) {
        this.bookingDate = BookingDate;
    }

    public void addService(Service s) {//Halah add 
        services.add(s);
    }

    public void setUser(User user) {
        if (user != null & user.getRole().equals("Guest")) {
            this.user = user;
        } else {
            System.out.println("Invalid user!");
        }
    }

    public void setInvoice(Invoice invoice) {// halah add 
        this.invoice = invoice;
    }

    public void setRoom(Room room) {
        if (room != null) {
            this.room = room;
        } else {
            System.out.println("Invalid room!");
        }
    }

    public void setGuestFeedBack(FeedBack guestFeedBack) {//halah add 
        this.guestFeedBack = guestFeedBack;
    }

    public String getReservationID() {
