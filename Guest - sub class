    public void ViewInvoice() {
        System.out.println(guestReservation.getLast().getInvoice());
    }

    public void MakeAPayment() {
        if (guestReservation.getLast().getInvoice().getPaymentStatus() == "Unpaid") {
            System.out.print("Choose a payment method: \n1.Cash \n2.Card \n3.Online Transfer");
            int paymentChoice = input.nextInt();

            switch (paymentChoice) {
                case 1:
                    guestReservation.getLast().getInvoice().setPaymentMethod("Cash");
                    break;
                case 2:
                    guestReservation.getLast().getInvoice().setPaymentMethod("Card");
                    break;
                case 3:
                    guestReservation.getLast().getInvoice().setPaymentMethod("Online Transfer");
                    break;
                default:
                    System.out.println("Invalid payment method!");
            }

            System.out.print("How much would you like to pay?");
            double payment = input.nextDouble();

            while (payment < 0 | payment > guestReservation.getLast().getInvoice().getTotalAmount()) {
                if (payment > guestReservation.getLast().getInvoice().getTotalAmount()) {
                    System.out.println("That exceeds your bills!");
                } else {
                    System.out.println("That is an invalid amount!");
                }

                System.out.println("Try again!");
                payment = input.nextDouble();
            }

            if (payment == guestReservation.getLast().getInvoice().getTotalAmount()) {
                guestReservation.getLast().getInvoice().setPaymentStatus("Paid");
            } else if (payment < guestReservation.getLast().getInvoice().getTotalAmount() & payment > 0) {
                guestReservation.getLast().getInvoice().setPaymentStatus("Partially Paid");
            }

            System.out.println("Payment succefull!");
            ViewInvoice();
        }
    }
