                }
                break;
            default:
                System.out.println("Invalid option!");

        }
    }

    public static void Guest(ArrayList<User> users, Guest guest) {
        
        System.out.println("----- Welcome " + guest.getUserName() + "! -----");
        System.out.println("What would you like to do? (Enter a number; 0 to exit)"
                + "\n1. Search for available rooms "
                + "\n2. Make a reservation"
                + "\n3. Cancel a reservation"
                + "\n4. View reservation details"
                + "\n5. Request a service"
                + "\n6. View invoice and payment status"
                + "\n7. Make a payment"
                + "\n8. Submit feedback"
                + "\n9. Update contact information");
        int choice = input.nextInt();

        while (choice != 0) { //the while loop insures that the user can do multiple services without having to restart the app multiple times
            switch (choice) {
                case 1:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Search Available Rooms --- ");
                    System.out.print("Enter a check in date: ");
                    String checkInDate = input.nextLine();
                    System.out.print("Enter a check out date: ");
                    String checkOutDate = input.nextLine();
                    System.out.print("Enter the number of guests: ");
                    int noOfGuests = input.nextInt();

                    System.out.println("Rooms available: ");

                    guest.SearchAvailableRooms(checkInDate, checkOutDate, noOfGuests, room, reservation);
                    break;
                case 2:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Make a Reservation --- ");
                    LocalDate date = LocalDate.now(); // to give an accurate booking date
                    String dateNow = date.toString(); 

                    System.out.print("Enter a check in date: ");
                    checkInDate = input.nextLine();
                    System.out.print("Enter a check out date: ");
                    checkOutDate = input.nextLine();
                    System.out.print("Enter the number of guests: ");
                    noOfGuests = input.nextInt();
                    System.out.println("Any special requests? ");
                    String specialRequests = input.nextLine();

                    System.out.println("Rooms available: "); // so the guest can choose a room that isn't reserved

                    guest.SearchAvailableRooms(checkInDate, checkOutDate, noOfGuests, room, reservation);
                    System.out.println("Which room would you like? (Enter the room number)");
                    String roomNumber = input.nextLine();

                    for (Room rooms : room) {
                        if (rooms.getRoomNumber() == roomNumber) {
                            reservation.add(new Reservation(guest.getUserId(), checkInDate, checkOutDate, noOfGuests, specialRequests, dateNow, rooms)); //creates and adds a reseravtion to the arraylist
                        }
                    }
                    
                    invoices.add(guest.getGuestReservation().getLast().getInvoice());//to save all the invoices in the hotel
                    
                    StatsDocument();// to update hotel stats on the txt doc
                    
                    break;
                case 3:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Cancel a Reservation --- ");
                    System.out.print("Enter your reservation ID: ");
                    String reservationID = input.nextLine();
                    for (Reservation reservation : guest.getGuestReservation()) { //uses reservation ID to identify which room to cancel
                        if (reservation.getReservationID() == reservationID) {
                            reservation.setReservationStatus("Cancelled");
                            System.out.println("Cancellation successfull!");
                        } else {
                            System.out.println("There is no reservation under this ID.");
                        }
                    }
                    
                    StatsDocument();// to update hotel stats on the txt doc
                    
                    break;
                case 4:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- View Reservation Details --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();
                    for (Reservation reservation : guest.getGuestReservation()) { //uses reservation ID to identify which room details to view
                        if (reservation.getReservationID() == reservationID) {
                            System.out.println(reservation);
                        } else {
                            System.out.println("There is no reservation under this ID.");
                        }
                    }
                    break;
                case 5:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Request a Service --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    for (Reservation reservation : guest.getGuestReservation()) { //uses reservation ID to save the services requested to the reservation for the guest
                        if (reservation.getReservationID() == reservationID) {
                            Service s = reservation.requestAService();
                            reservation.getService().add(s);
                            services.add(s);// to save all the services requested in the hotel
                            System.out.println("Request successfull!");
                        } else {
                            System.out.println("There is no reservation under this ID.");
                        }
                    }
                    
                    StatsDocument();// to update hotel stats on the txt doc
                    
                    break;
                case 6:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- View Invoice and Payment Status --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    for (Reservation reservation : guest.getGuestReservation()) { //uses reservation ID to identify which invoice to view
                        if (reservation.getReservationID() == reservationID) {
                            guest.ViewInvoice(reservation);
                        } else {
                            System.out.println("There is no reservation under this ID.");
                        }
                    }
                    break;
                case 7:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Make a Payment --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    for (Reservation reservation : guest.getGuestReservation()) { //uses reservation ID to identify which invoice to view and pay
                        if (reservation.getReservationID() == reservationID) {
                            guest.MakeAPayment(reservation);
                        } else {
                            System.out.println("There is no reservation under this ID.");
                        }
                    }
                    
                    StatsDocument();// to update hotel stats on the txt doc
                    
                    break;
                case 8:
                    System.out.println("--------------------------------------------------------------\n");

                    System.out.println(" --- Submit Feedback --- ");
                    System.out.print("Enter your reservation ID: ");
                    reservationID = input.nextLine();

                    for (Reservation reservation : guest.getGuestReservation()) { //uses reservation ID to save the feedback submitted to the reservation for the guest
                        if (reservation.getReservationID() == reservationID) {
                            FeedBack f = reservation.submitGuestFeedback();
                            reservation.setGuestFeedBack(f);
                            feedBacks.add(f);// to save all the feedback the hotel recieves
                        } else {
                            System.out.println("There is no reservation under this ID.");
                        }
                    }
                    
                    StatsDocument();// to update hotel stats on the txt doc
                    
                    break;
                case 9:
                    guest.updateupdateContactInfo();//if the guest wants to edit any personal info
                    
                    StatsDocument();// to update hotel stats on the txt doc
                    
                    break;
                default:
                    System.out.println("Invalid option!");
            }

            System.out.println("Would you like to do anything else?(Enter a number; 0 to exit)" 
                    + "\n1. Search for available rooms "
                    + "\n2. Make a reservation"
                    + "\n3. Cancel a reservation"
                    + "\n4. View reservation details"
                    + "\n5. Request a service"
                    + "\n6. View invoice and payment status"
                    + "\n7. Make a payment"
                    + "\n8. Submit feedback"
                    + "\n9. Update contact information");
            choice = input.nextInt();
        }
    }

